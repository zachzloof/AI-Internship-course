OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# Required for the ADK agent (agent_app.py) -- Gemini model access
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Required for Langfuse tracing (/ask, /ingest, /debug/retrieve, /agent, and the
# Streamlit Agent Trace page). Get a free project at https://cloud.langfuse.com,
# then Settings -> API Keys. Without these, langfuse.get_client() runs in a disabled
# no-op mode -- the app still works, it just doesn't send traces.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud shown below; use https://us.cloud.langfuse.com for US cloud, or your
# self-hosted URL.
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Required for escalation_agent's ticket filing (execute_sql via Supabase's hosted MCP
# server). Drafting works without these; only filing needs them.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
